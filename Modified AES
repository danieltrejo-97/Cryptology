        [96, 129, 79, 220, 34, 42, 144, 136, 70, 238, 184, 20, 222, 94, 11, 219],
        [224, 50, 58, 10, 73, 6, 36, 92, 194, 211, 172, 98, 145, 149, 228, 121],
        [231, 200, 55, 109, 141, 213, 78, 169, 108, 86, 244, 234, 101, 122, 174, 8],
        [186, 120, 37, 46, 28, 166, 180, 198, 232, 221, 116, 31, 75, 189, 139, 138],
        [112, 62, 181, 102, 72, 3, 246, 14, 97, 53, 87, 185, 134, 193, 29, 158],
        [225, 248, 152, 17, 105, 217, 142, 148, 155, 30, 135, 233, 206, 85, 40, 223],
        [140, 161, 137, 13, 191, 230, 66, 104, 65, 153, 45, 15, 176, 84, 187, 22]
    ])

    transformed_matrix = np.vectorize(lambda x: s_box[(x % 256) // 16, (x % 256) % 16])(matrix % 256)
    return transformed_matrix

def aes_encrypt(plaintext, key):
    state = np.array([(plaintext >> (8 * i)) & 0xFF for i in range(15, -1, -1)]).reshape((4, 4))
    round_keys = key_schedule(key)

    state = state ^ round_keys[0][0]

    for round in range(1, 10):
        state = s_box_transform(state)
        # Añadir otras transformaciones de AES (ShiftRows, MixColumns, AddRoundKey)

    state = s_box_transform(state)
    state = state ^ round_keys[-1][0]

    return int.from_bytes([x % 256 for x in state.flatten()], byteorder='big')

def aes_decrypt(ciphertext, key):
    state = np.array([(ciphertext >> (8 * i)) & 0xFF for i in range(15, -1, -1)]).reshape((4, 4))
    round_keys = key_schedule(key)

    state = state ^ round_keys[-1][0]
    state = s_box_transform(state)

    for round in range(9, 0, -1):
        state = s_box_transform(state)
        state = state ^ round_keys[round][0]

    state = state ^ round_keys[0][0]

    return int.from_bytes([x % 256 for x in state.flatten()], byteorder='big')

