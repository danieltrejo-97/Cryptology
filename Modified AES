# Cifrado AES modificado
#--------------------------------------------------------------------------

import numpy as np

def is_invertible(matrix):
    try:
        np.linalg.inv(matrix)
        return True
    except np.linalg.LinAlgError:
        return False

def matrix_inverse(matrix):
    if not is_invertible(matrix):
        raise ValueError("Matrix is not invertible.")

    return np.linalg.inv(matrix) % 256

def key_schedule(k):
    keys = []
    for j in range(1, 11):
        z1 = (k >> (128 - 64)) ^ j  # XOR con el número de iteración
        z2 = (k & ((1 << 64) - 1)) ^ (j * 3)  # XOR con iteración modificada
        keys.append((z1, z2))
    return keys

def s_box_transform(matrix):
    s_box = np.array([
        [99, 124, 119, 123, 242, 107, 111, 197, 48, 1, 103, 43, 254, 215, 171, 118],
        [202, 130, 201, 125, 250, 89, 71, 240, 173, 212, 162, 175, 156, 164, 114, 192],
